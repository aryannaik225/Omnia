# Copy to .env (git-ignored). Read at BUILD time by src-tauri/build.rs and compiled into the
# Rust binary only; none of these reach the JS bundle (vite.config.ts only exposes VITE_OMNIA_*).

# TMDB v3 API key or v4 read access token. Used only for public catalog metadata.
TMDB_API_KEY=

# Optional two-way cloud sync (Settings → Sign in to Sync). Leave empty to build a 100% local app.
# Supabase → Project Settings → API. The anon / publishable key is public by design (RLS on
# every table, see supabase/schema.sql). NEVER put the service-role / secret key here: the build fails if you do.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
