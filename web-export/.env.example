# Copy to .env.local (never commit it). On Vercel: Project → Settings → Environment Variables.

# --- Public (inlined into the browser bundle; safe ONLY because RLS is on every table) -------
# Supabase → Project Settings → API. Use the anon / publishable key, NEVER the service-role key
# (the build refuses to run if a secret key is put here).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public URL of the deployment (e-mail confirmation links). On Vercel: https://<project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (read in Route Handlers / Server Components; never sent to the browser) -----
# TMDB v3 API key or v4 read token. All TMDB calls go through /app/api/tmdb and /app/api/titles.
TMDB_API_KEY=
# Optional: a GitHub token (no scopes needed for a public repo) raises the server's API rate limit
# for the landing page's "latest release" lookup.
GITHUB_TOKEN=
# Omnia never needs SUPABASE_SERVICE_ROLE_KEY. Do not add it here.
