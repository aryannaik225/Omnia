# Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# TMDB v3 API key or v4 read token. Server-only (never sent to the browser).
TMDB_API_KEY=
# Default catalog region (ISO 3166-1 alpha-2) until a user picks one.
DEFAULT_REGION=IN
# Public URL of the deployment (e-mail confirmation links). On Vercel: https://<project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
